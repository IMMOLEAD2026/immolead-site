<script>
var s=document.querySelectorAll('.slide'),i=0,c=document.getElementById('c');
function go(k){i=Math.max(0,Math.min(s.length-1,k));for(var j=0;j<s.length;j++){s[j].classList.toggle('on',j===i)}c.textContent=(i+1)+' / '+s.length;var pb=document.getElementById('prog');if(pb)pb.style.width=((i+1)/s.length*100)+'%';if(typeof calc4==='function')calc4();if(typeof playCounts==='function')playCounts(s[i])}
document.getElementById('n').onclick=function(){go(i+1)};
document.getElementById('p').onclick=function(){go(i-1)};

/* --- compteurs animés --- */
function setupCount(el){
  var t=el.textContent.trim();
  var m=t.match(/^([^\d-]*)(-?[\d\s\u202f.,]+)(.*)$/);
  if(!m)return null;
  var raw=m[2].replace(/[\s\u202f]/g,'');
  var dec=/,\d/.test(raw);
  var val=parseFloat(raw.replace(',','.').replace(/\.(?=\d{3}\b)/g,''));
  if(isNaN(val)||val===0)return null;
  return {pre:m[1],suf:m[3],val:val,dec:dec};
}
function runCount(el){
  var d=el._cd;if(!d)return;
  var t0=null,dur=900;
  function step(ts){
    if(!t0)t0=ts;
    var p=Math.min((ts-t0)/dur,1);
    var e=1-Math.pow(1-p,3);
    var v=d.val*e;
    var txt=d.dec? v.toFixed(1).replace('.',',') : Math.round(v).toLocaleString('fr-FR');
    el.textContent=d.pre+txt+d.suf;
    if(p<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function initCounts(){}
function playCounts(slide){
  slide.querySelectorAll('.hero, .card .n').forEach(function(el){
    if(el.querySelector('.ed'))return;
    var d=setupCount(el);          /* relit la valeur affichée au moment de l'animation */
    if(d){el._cd=d;runCount(el)}
  });
}
/* --- interface masquable --- */
document.addEventListener('keydown',function(e){
  if(e.target.isContentEditable)return;
  if(e.key==='f'||e.key==='F'){document.body.classList.toggle('clean')}
});

function fmtn(v){var n=parseFloat(String(v).replace(/[^0-9.,-]/g,'').replace(',','.'));return isNaN(n)?String(v):n.toLocaleString('fr-FR')}
function setAll(cls,val){document.querySelectorAll('.'+cls).forEach(function(e){e.textContent=val})}
function syncData(){
  var g=function(id){var e=document.getElementById(id);return e?e.textContent.trim():''};
  setAll('jv',fmtn(g('cVen')));
  setAll('jm2',fmtn(g('cM2')));
  setAll('jpm',fmtn(g('cPm')));
  var f3=document.getElementById('f3'),f4=document.getElementById('f4');
  if(f3)f3.textContent=String(g('cVen')).replace(/[^0-9]/g,'');
  if(f4)f4.textContent=String(g('cAg')).replace(/[^0-9]/g,'');
  if(typeof calc4==='function')calc4();
}
/* ---- comptage des agents immobiliers (SIRENE via API Recherche d'entreprises) ---- */
function distKm(la1,lo1,la2,lo2){var R=6371,r=Math.PI/180,dLa=(la2-la1)*r,dLo=(lo2-lo1)*r;
var a=Math.sin(dLa/2)*Math.sin(dLa/2)+Math.cos(la1*r)*Math.cos(la2*r)*Math.sin(dLo/2)*Math.sin(dLo/2);
return 2*R*Math.asin(Math.sqrt(a));}
var API_ENT='https://recherche-entreprises.api.gouv.fr/search';
var AG_ERR=0,AG_OK=0,AG_LOG=1;
function countCP(cp){
  return fetch(API_ENT+'?activite_principale=68.31Z&etat_administratif=A&per_page=1&code_postal='+cp)
    .then(function(x){if(!x.ok)throw new Error('HTTP '+x.status);return x.json()})
    .then(function(d){
      if(AG_LOG){AG_LOG=0;console.log('[agents] reponse exemple',cp,d)}
      if(!d||typeof d.total_results!=='number')throw new Error('champ total_results absent');
      AG_OK++;return d.total_results;
    });
}
function chargerAgents(cp,rayon){
  var sa=document.getElementById('cSa');
  sa.className='cfgst';sa.textContent='\u2026';
  return fetch('https://geo.api.gouv.fr/communes?codePostal='+cp+'&fields=code,centre,population&format=json')
  .then(function(x){if(!x.ok)throw new Error('geo cp '+x.status);return x.json()})
  .then(function(l){
    if(!l||!l.length)throw new Error('cp inconnu');
    var c=l.slice().sort(function(a,b){return (b.population||0)-(a.population||0)})[0];
    var co=c.centre.coordinates,dep=c.code.slice(0,2)==='97'?c.code.slice(0,3):c.code.slice(0,2);
    return fetch('https://geo.api.gouv.fr/departements/'+dep+'/communes?fields=centre,codesPostaux&format=json')
      .then(function(x){if(!x.ok)throw new Error('geo dep '+x.status);return x.json()})
      .then(function(all){
        var seen={},list=[];
        (all||[]).forEach(function(k){
          if(!k.centre||!k.centre.coordinates)return;
          var kc=k.centre.coordinates;
          if(distKm(co[1],co[0],kc[1],kc[0])<=rayon){
            (k.codesPostaux||[]).forEach(function(z){if(!seen[z]){seen[z]=1;list.push(z)}});
          }
        });
        if(!list.length)list=[cp];
        return list;
      });
  })
  .then(function(list){
    var total=0,i=0,n=list.length;AG_ERR=0;AG_OK=0;AG_LOG=1;
    sa.textContent='0/'+n;
    function suite(){
      if(i>=n){
        if(AG_OK===0){sa.className='cfgst err';sa.textContent='API KO ('+AG_ERR+')';return}
        document.getElementById('cAg').textContent=total;
        syncData();
        sa.className='cfgst ok';
        sa.textContent='\u2713 '+total+' agents'+(AG_ERR?' ('+AG_ERR+' err)':'');
        return;
      }
      var lot=list.slice(i,i+4);i+=4;
      return Promise.all(lot.map(function(z){return countCP(z).catch(function(e){AG_ERR++;if(AG_ERR===1)console.error('[agents] echec',z,e.message);return 0})}))
        .then(function(res){
          res.forEach(function(v){total+=v});
          sa.textContent=Math.min(i,n)+'/'+n;
          return new Promise(function(r){setTimeout(r,120)}).then(suite);
        });
    }
    return suite();
  })
  .catch(function(e){
    console.error('agents',e);
    var sa=document.getElementById('cSa');
    sa.className='cfgst err';sa.textContent='manuel';
  });
}

function setTxt(id,v){var e=document.getElementById(id);if(e)e.textContent=v}
function chargerDVF(){
  var cp=(document.getElementById('cCp').textContent||'').replace(/[^0-9]/g,'');
  var r=document.getElementById('cRay').value;
  var st=document.getElementById('cSt');
  if(!/^\d{5}$/.test(cp)){st.className='cfgst err';st.textContent='CP invalide';return}
  st.className='cfgst';st.textContent='Chargement…';
  fetch('/.netlify/functions/market?cp='+cp+'&r='+r)
    .then(function(x){return x.json()})
    .then(function(d){
      if(d.couvert===false){st.className='cfgst err';st.textContent='Non couvert';return}
      if(!d.panneau){st.className='cfgst err';st.textContent='Volume insuffisant';return}
      if(d.nb_ventes!=null)setTxt('cVen',d.nb_ventes);
      if(d.prix_m2_median!=null)setTxt('cM2',d.prix_m2_median);
      if(d.prix_median!=null)setTxt('cPm',d.prix_median);
      if(d.commune_centre)setAll('jc',d.commune_centre);
      setAll('jp',cp);
      if(d.periode)setAll('jper',d.periode);
      if(d.nb_communes)setAll('jnc',d.nb_communes+(d.nb_communes>1?' communes':' commune'));
      setAll('jray',d.rayon_km||r);
      syncData();
      st.className='cfgst ok';
      st.textContent=(d.depuis_cache?'✓ cache':'✓ DVF ')+(d.annee_donnees||'');
      chargerAgents(cp,parseInt(d.rayon_km||r,10));
    })
    .catch(function(){st.className='cfgst err';st.textContent='Hors ligne — saisie manuelle'});
}
document.getElementById('cGo').addEventListener('click',chargerDVF);
document.getElementById('cCp').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();chargerDVF()}});
document.getElementById('cRay').addEventListener('change',chargerDVF);
['cVen','cM2','cPm','cAg'].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener('input',syncData)});

function syncGeo(){
  var p=document.getElementById('cCp');if(!p)return;
  document.querySelectorAll('.jp').forEach(function(e){e.textContent=p.textContent.trim()});
}
['cCp'].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener('input',syncGeo)});
syncGeo();
syncData();

function nb(el){var v=(el.textContent||'').replace(/[^0-9,.]/g,'').replace(',','.');var n=parseFloat(v);return isNaN(n)?0:n}
function fmt(n){return Math.round(n).toLocaleString('fr-FR')}
function calc4(){
  var f1=document.getElementById('f1');if(!f1)return;
  var mes=nb(f1),hon=nb(document.getElementById('f2')),tot=nb(document.getElementById('f3')),ag=nb(document.getElementById('f4'));
  var moy = ag>0 ? tot/ag : 0;
  var ecart = moy-mes;
  var mag=document.getElementById('mag'),lbl=document.getElementById('lbl4'),txt=document.getElementById('txt4');
  if(ecart>0){
    lbl.textContent='Ce que représentent les ventes qui vous échappent';
    mag.textContent=fmt(ecart*hon)+' €';
    txt.innerHTML='Sur votre secteur, un agent signe <b style="color:#1A3D2C">'+moy.toFixed(1).replace('.',',')+' ventes</b> par an en moyenne. Vous en faites <b style="color:#1A3D2C">'+fmt(mes)+'</b>. L\'écart vaut '+fmt(ecart*hon)+' € d\'honoraires — et ce n\'est que la moyenne, pas le haut du panier.';
  } else {
    lbl.textContent='Vous êtes déjà au-dessus de la moyenne de votre secteur';
    mag.textContent='+'+Math.abs(ecart).toFixed(1).replace('.',',')+' ventes';
    txt.innerHTML='La moyenne du secteur est de <b style="color:#1A3D2C">'+moy.toFixed(1).replace('.',',')+' ventes</b> par agent. Vous en faites <b style="color:#1A3D2C">'+fmt(mes)+'</b>. Votre enjeu n\'est pas de rattraper les autres — c\'est de prendre le territoire pendant qu\'ils cherchent encore comment remplacer la pige.';
  }
  var mx=Math.max(mes,moy,1);
  document.getElementById('barV').style.width=(mes/mx*100)+'%';
  document.getElementById('barM').style.width=(moy/mx*100)+'%';
  document.getElementById('lv').textContent=fmt(mes)+' ventes / an';
  document.getElementById('lm').textContent=moy.toFixed(1).replace('.',',')+' ventes / an';
}
['f1','f2','f3','f4'].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener('input',calc4)});
calc4();
setTimeout(function(){var f=document.querySelector('.slide.on');if(f&&typeof playCounts==='function')playCounts(f)},250);

document.addEventListener('keydown',function(e){
if(e.target.isContentEditable)return;
if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();go(i+1)}
if(e.key==='ArrowLeft'){e.preventDefault();go(i-1)}
});
</script>
